# ─── Public site ───────────────────────────────────────────────────────────────
# Canonical URL used for metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://tsefackdev.vercel.app

# Optional: Google Search Console verification token (meta tag method).
GOOGLE_SITE_VERIFICATION=

# ─── Studio (/admin) ──────────────────────────────────────────────────────────
# Required in production. Choose a strong passphrase.
ADMIN_PASSWORD=change-me-please
# Recommended: a long random string (used to sign the session cookie).
# openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ─── Optional: publish by committing to GitHub ────────────────────────────────
# When these are set, the studio writes content/projects.json through the
# GitHub Contents API and triggers an automatic redeploy on Vercel.
# The token needs "Contents: Read and write" on the repository below.
GITHUB_TOKEN=
GITHUB_REPO=TSEFACKDEV/portfolio
GITHUB_BRANCH=main
